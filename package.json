{
  "name": "awcli",
  "version": "0.1.0",
  "description": "Run TypeScript agentic workflows from a global install",
  "type": "module",
  "bin": {
    "awcli": "dist/main.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "npm run build",
    "check:contract": "tsc --noEmit",
    "build": "npm run check:contract && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:global": "bash scripts/verify-global-install.sh",
    "check": "npm run format:check && npm run test && npm run build",
    "check:gates": "npm run verify:typecheck-gate && npm run verify:contract-gate && npm run verify:packaged-declaration && npm run verify:spec-invariants && npm run verify:disposal-gate && npm run verify:lock-gate && npm run verify:acquisition-returns && npm run verify:mutation-gate",
    "verify:typecheck-gate": "bash scripts/verify-typecheck-gate.sh",
    "verify:contract-gate": "bash scripts/verify-contract-gate.sh",
    "verify:disposal-gate": "bash scripts/verify-disposal-gate.sh",
    "verify:lock-gate": "bash scripts/verify-lock-gate.sh",
    "verify:acquisition-returns": "bash scripts/verify-acquisition-returns.sh",
    "verify:mutation-gate": "bash scripts/verify-mutation-gate.sh",
    "verify:packaged-declaration": "bash scripts/verify-packaged-declaration.sh",
    "verify:spec-invariants": "bash scripts/verify-spec-invariants.sh"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
