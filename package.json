{
  "name": "awcli",
  "version": "0.1.0",
  "description": "Run TypeScript agentic workflows from a global install",
  "type": "module",
  "bin": {
    "awcli": "dist/main.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:global": "bash scripts/verify-global-install.sh",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "verify:typecheck-gate": "bash scripts/verify-typecheck-gate.sh"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
